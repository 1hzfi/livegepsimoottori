#!/usr/bin/env bash
set -e
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
BASEDIR=$(dirname $DIR)
PID_FILE=${BASEDIR}/var/tasks.pid

cd $BASEDIR
echo -e "\e[96mComparing requirements\e[0m"
PREV_MD5SUM="$(md5sum requirements.txt)"
curl -s -O -L https://raw.github.com/1hzfi/livegepsimoottori/${1:-live}/requirements.txt
NEW_MD5SUM="$(md5sum requirements.txt)"
if [ "$NEW_MD5SUM" != "$PREV_MD5SUM" ]
then
  echo "Installing new requirements"
  source ~/.cargo/env
  source ~/.local/bin/env
  uv pip install --no-cache --requirement requirements.txt
else
  echo "No new requirements"
fi
echo -e "\e[96mUpdating env variables\e[0m"
doppler secrets download --no-file --format=env 1> ".env"
echo "Done"
echo -e "\e[96mFetching new code\e[0m"
git fetch
git reset --hard ${1:-origin/live}
echo -e "\e[96mCollecting static files\e[0m"
uv run manage.py collectstatic --noinput
echo -e "\e[96mCompressing assets\e[0m"
uv run manage.py compress --force
find static/CACHE/js/ -type f -name "*.js" -print0 | while IFS= read -r -d '' file; do
  filename=$(basename "$file")
  if [ ! -f "static/CACHE/js/$filename.gz" ]; then
    gzip --best --keep static/CACHE/js/$filename
  fi
  if [ ! -f "static/CACHE/js/$filename.br" ]; then
    brotli --best --keep static/CACHE/js/$filename
  fi
done
find static/CACHE/css/ -type f -name "*.css" -print0 | while IFS= read -r -d '' file; do
  filename=$(basename "$file")
  if [ ! -f "static/CACHE/css/$filename.gz" ]; then
    gzip --best --keep static/CACHE/css/$filename
  fi
  if [ ! -f "static/CACHE/css/$filename.br" ]; then
    brotli --best --keep static/CACHE/css/$filename
  fi
done

uv run manage.py migrate --noinput
echo -e "\e[96mRestarting services\e[0m"
./bin/restart-all
echo "Done"
echo -e "\e[92mNew version deployed\e[0m"
